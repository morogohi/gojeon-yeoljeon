{
  "name": "gojeon",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite -c vite.site.config.ts",
    "build:app": "vite build",
    "build:site": "vite build -c vite.site.config.ts && node scripts/assemble-site.mjs",
    "build": "npm run build:app && npm run build:site",
    "typecheck": "tsc",
    "test": "vitest run",
    "e2e": "playwright test",
    "cap:sync": "npm run build:app && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor \"#18222f\" --iconBackgroundColorDark \"#18222f\" --splashBackgroundColor \"#18222f\" --splashBackgroundColorDark \"#18222f\"",
    "store:shots": "node scripts/store-shots.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  }
}
