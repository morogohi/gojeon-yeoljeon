{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gojeon.local/qa/develop-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "tool",
    "iteration",
    "reason"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "no_change",
        "blocked",
        "error",
        "skipped"
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "claude",
        "stub",
        "none"
      ]
    },
    "iteration": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    }
  }
}
